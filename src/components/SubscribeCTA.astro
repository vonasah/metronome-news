---
// src/components/SubscribeCTA.astro
// Subscribe call-to-action shown at the end of each article.
// Encourages readers to follow Metronome News on social channels.
---

<aside class="subscribe-cta" aria-label="Subscribe to Metronome News">
	<div class="subscribe-cta-inner">
		<div class="subscribe-cta-content">
			<h3 class="subscribe-cta-title">Stay in the rhythm</h3>
			<p class="subscribe-cta-text">
				Original crypto and Web3 analysis. Daily. No hype, no algorithm, no ads.
				Get every story where you read.
			</p>
		</div>
		<div class="subscribe-cta-buttons">
			<a
				href="https://x.com/Metronome_News"
				target="_blank"
				rel="noopener noreferrer"
				class="subscribe-btn"
				aria-label="Follow Metronome News on X"
			>
				<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<path
						d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
						fill="currentColor"
					/>
				</svg>
				<span>Follow on X</span>
			</a>

			<a
				href="https://t.me/metronomenews"
				target="_blank"
				rel="noopener noreferrer"
				class="subscribe-btn"
				aria-label="Join Metronome News on Telegram"
			>
				<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<path
						d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"
						fill="currentColor"
					/>
				</svg>
				<span>Join Telegram</span>
			</a>

			<a
				href="https://coinmarketcap.com/community/profile/metronome_news/"
				target="_blank"
				rel="noopener noreferrer"
				class="subscribe-btn"
				aria-label="Follow Metronome News on CoinMarketCap"
			>
				<svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-width="2" />
					<path
						d="M 8 20 L 12 14 L 16 18 L 20 12 L 24 16"
						fill="none"
						stroke="currentColor"
						stroke-width="2.2"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
					<circle cx="20" cy="12" r="1.4" fill="currentColor" />
				</svg>
				<span>CoinMarketCap</span>
			</a>
		</div>
	</div>
</aside>

<style>
	.subscribe-cta {
		margin: 3rem 0 2rem 0;
		padding: 2rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		position: relative;
		overflow: hidden;
	}

	/* Top gradient accent line, matches Hero card */
	.subscribe-cta::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: var(--gradient-brand);
	}

	.subscribe-cta-inner {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 2rem;
		align-items: center;
	}

	.subscribe-cta-title {
		font-size: 1.4rem;
		font-weight: 800;
		margin: 0 0 0.5rem 0;
		background: var(--gradient-brand);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		letter-spacing: -0.01em;
	}

	.subscribe-cta-text {
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--color-text-muted);
		margin: 0;
		max-width: 480px;
	}

	.subscribe-cta-buttons {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.subscribe-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 1rem;
		background: var(--color-bg-primary, var(--color-surface-alt));
		border: 1px solid var(--color-border);
		border-radius: 0.6rem;
		text-decoration: none;
		color: var(--color-text);
		font-size: 0.85rem;
		font-weight: 500;
		transition: all 0.15s ease;
		min-width: 180px;
		justify-content: flex-start;
	}

	.subscribe-btn:hover {
		background: var(--gradient-brand);
		color: white;
		border-color: transparent;
		transform: translateX(2px);
	}

	.subscribe-btn svg {
		width: 18px;
		height: 18px;
		flex-shrink: 0;
	}

	@media (max-width: 700px) {
		.subscribe-cta {
			margin: 2.5rem 0 1.5rem 0;
			padding: 1.5rem;
		}
		.subscribe-cta-inner {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}
		.subscribe-cta-title {
			font-size: 1.2rem;
		}
		.subscribe-cta-text {
			font-size: 0.9rem;
		}
		.subscribe-cta-buttons {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 0.4rem;
		}
		.subscribe-btn {
			min-width: 0;
			flex: 1;
			justify-content: center;
			padding: 0.6rem 0.75rem;
			font-size: 0.8rem;
		}
		.subscribe-btn span {
			display: none;
		}
	}

	@media (max-width: 400px) {
		.subscribe-btn {
			padding: 0.6rem;
		}
	}
</style>
